# Copy to .env.local and change these before going live.

# PIN the owner types to open the dashboard. Pick 6+ digits for a real factory.
OWNER_PIN=1234

# Long random string used to sign the owner's login cookie.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=dev-only-secret-change-me

# Where data lives. Default is a local SQLite file. For Turso use libsql://... plus DATABASE_AUTH_TOKEN.
DATABASE_URL=file:data/kaamtrack.db
# DATABASE_AUTH_TOKEN=

# Folder where start/end photos are saved.
UPLOAD_DIR=data/uploads

# Factory timezone (decides what "today" means).
APP_TIMEZONE=Asia/Kolkata

# Shown on the leaderboard, e.g. "₹5,000 bonus for #1"
MONTHLY_REWARD="₹5,000 bonus for #1"
