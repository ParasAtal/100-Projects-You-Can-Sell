{
  "name": "kaamtrack",
  "version": "0.1.0",
  "private": true,
  "description": "Open-source task timer for factories: owner sets tasks and expected time, workers start/end with a photo, monthly points leaderboard.",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "demo": "node scripts/seed-demo.mjs",
    "dev:demo": "DATABASE_URL=file:data/demo.db UPLOAD_DIR=data/demo-uploads next dev"
  },
  "dependencies": {
    "@libsql/client": "^0.18.0",
    "next": "^15.5.29",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "typescript": "^5"
  }
}
